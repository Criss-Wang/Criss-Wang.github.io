---
import BaseLayout from "../layouts/BaseLayout.astro";
import { profile } from "../data/profile";

const findLink = (label: string) => profile.links.find((link) => link.label === label)?.href ?? "#";

const contactRows = [
  { label: "email", value: profile.email, href: `mailto:${profile.email}` },
  { label: "github", value: "github.com/Criss-Wang", href: findLink("GitHub") },
  { label: "linkedin", value: "linkedin.com/in/zhenlin-wang", href: findLink("LinkedIn") },
  { label: "twitter", value: "twitter.com/CrissWang4", href: findLink("Twitter") },
  { label: "scholar", value: "Google Scholar", href: findLink("Scholar") },
];
---

<BaseLayout title="Contact" description={`Contact ${profile.name}.`} section="contact">
  <main class="contact-page">
    <section class="page-head contact-head">
      <div class="preheader">Contact</div>
      <h1>Reach out for <em>research</em>, projects, or notes.</h1>
      <p class="lede">Paper pointers, project questions, corrections, and technical conversations are welcome.</p>
    </section>

    <section class="contact-directory" aria-label="Contact links">
      {contactRows.map((row) => (
        <a class="contact-directory-row" href={row.href}>
          <span>{row.label}</span>
          <strong>{row.value}</strong>
        </a>
      ))}
    </section>
  </main>
</BaseLayout>
