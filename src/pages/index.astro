---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { homeHero, homeProjectMeta } from "../data/home";
import liveStatsJson from "../data/live-stats.json";
import { profile } from "../data/profile";
import { now } from "../data/now";
import { publications, scholarProfileUrl } from "../data/publications";
import {
  excerptFor,
  isProjectPost,
  postCategories,
  postDate,
  postUrl,
  readingMinutes,
  sortPosts,
} from "../lib/posts";

const posts = sortPosts(await getCollection("posts", ({ data }) => !data.draft));
const recent = posts.slice(0, 3);
const projectPosts = posts.filter(isProjectPost).slice(0, 4);
const projectMeta = (title: string) => homeProjectMeta[title] ?? { status: "archived" as const };
const techTags = (post: typeof projectPosts[number], meta = projectMeta(post.data.title)) =>
  (meta.featuredTags ?? postCategories(post))
    .filter((tag) => tag.toLowerCase() !== "projects")
    .slice(0, 3);
const displayDate = (date: Date) => {
  const year = date.getUTCFullYear();
  const month = String(date.getUTCMonth() + 1).padStart(2, "0");
  const day = String(date.getUTCDate()).padStart(2, "0");
  return `${year}·${month}·${day}`;
};
const liveStats = liveStatsJson as {
  repositories: Record<
    string,
    {
      name?: string;
      url?: string;
      stars?: number;
      commits?: number | null;
      pushedAt?: string;
      source?: string;
    }
  >;
};
const authorParts = (authors: string) => authors.split(profile.name);
const repoAge = (pushedAt?: string) => {
  if (!pushedAt) return null;
  const pushed = new Date(pushedAt);
  const now = new Date();
  const months =
    (now.getUTCFullYear() - pushed.getUTCFullYear()) * 12 + now.getUTCMonth() - pushed.getUTCMonth();
  if (months < 12) return `${Math.max(1, months)}mo`;
  return `${Math.max(1, Math.floor(months / 12))}y`;
};
---

<BaseLayout title={profile.name} description={profile.tagline} section="home">
  <section class="site-notice" aria-label="Live update">
    <span class="live-dot" aria-hidden="true"></span>
    <p><strong>Live update</strong> by Claude + Codex</p>
  </section>

  <section class="hero">
    <div class="hero-copy">
      <div class="identity-strip">
        {homeHero.roles.map((role, index) => (
          <>
            <span>{role}</span>
            {index < homeHero.roles.length - 1 && <b aria-hidden="true">·</b>}
          </>
        ))}
      </div>
      <h1>
        Writing &amp; building ML <em>systems</em> that make models <em>work</em>.
      </h1>
      <p class="hero-lede">{homeHero.intro}</p>
      <div class="hero-tags" aria-label="Focus areas">
        <strong>Research Focus:</strong>
        {homeHero.topics.map((topic, index) => <span class:list={[index === 0 && "active"]}>{topic}</span>)}
      </div>
    </div>
    <aside class="now-card" aria-label="Now">
      <div class="now-head">
        <h3><span class="slash">/</span> now</h3>
        <span class="stamp">{now.updated}</span>
      </div>
      <dl>
        {now.items.map((item, index) => (
          <>
            <dt>{item.label}</dt>
            <dd class:list={[(item.tone === "highlight" || index === 0) && "status"]}>
              <span>{item.value}</span>
              {"detail" in item && item.detail && <small>{item.detail}</small>}
            </dd>
          </>
        ))}
      </dl>
    </aside>
  </section>

  <main class="home-main">
    <section class="home-section writing-section" id="writing">
      <div class="home-section-head compact-section-head">
        <div class="section-kicker"><span>01</span>Writing</div>
        <a href="/writing/" class="see-all">all writing -></a>
      </div>

      <div class="writing-list">
        {recent.map((post, index) => (
          <a class:list={["writing-row", index === 0 && "featured"]} href={postUrl(post)}>
            <div class="writing-date">
              {index === 0 && <span class="badge">featured</span>}
              <span>{displayDate(postDate(post))}</span>
            </div>
            <div class="writing-body">
              <h3>{post.data.title}</h3>
              <p>{excerptFor(post)}</p>
            </div>
            <div class="writing-read">{readingMinutes(post.body)} min</div>
          </a>
        ))}
      </div>
    </section>

    <section class="home-section publications-section" id="publications">
      <div class="home-section-head compact-section-head">
        <div class="section-kicker"><span>02</span>Selected publications</div>
        <a href={scholarProfileUrl} class="see-all">google scholar -></a>
      </div>

      <div class="home-pubs">
        {publications.slice(0, 3).map((pub) => (
          (() => {
            const citationCount = pub.citationCount;
            return (
              <article class="home-pub">
                <div class="venue-block">
                  <span class="v">{pub.venue}</span>
                  <span class="year">{pub.year} · {pub.track ?? "main"}</span>
                </div>
                <div>
                  <h3>{pub.title}</h3>
                  <p class="authors">
                    {authorParts(pub.authors).map((part, index) => (
                      <>
                        {index > 0 && <strong>{profile.name}</strong>}
                        {part}
                      </>
                    ))}
                  </p>
                  <div class="links">
                    {pub.links.map((link) => <a href={link.href}>{link.label}</a>)}
                  </div>
                </div>
                <div class="citation-count">
                  {citationCount === null ? (
                    <a href={pub.scholarUrl}>Scholar</a>
                  ) : (
                    <a href={pub.scholarUrl} title="Google Scholar citation snapshot">
                      <strong>{citationCount}</strong>
                      <span>cited</span>
                    </a>
                  )}
                </div>
              </article>
            );
          })()
        ))}
      </div>
    </section>

    <section class="home-section projects-section" id="projects">
      <div class="home-section-head compact-section-head">
        <div class="section-kicker"><span>03</span>Projects</div>
        <a href="https://github.com/Criss-Wang/" class="see-all">github -></a>
      </div>

      <div class="home-project-grid">
        {projectPosts.map((post) => {
          const meta = projectMeta(post.data.title);
          const repoStats = liveStats.repositories[post.data.title];
          const age = repoAge(repoStats?.pushedAt ?? meta.pushedAt);
          const stars = repoStats?.stars ?? meta.stars;
          const commits = repoStats?.commits;
          const repoUrl = repoStats?.url ?? meta.repoUrl;
          const repoTitle = repoStats?.name ?? meta.repoTitle ?? post.data.title;
          return (
            <article class="home-project-card">
              <div class="project-head">
                <h3>
                  {repoUrl ? <a href={repoUrl}>{repoTitle}</a> : repoTitle}
                </h3>
                <span class:list={["status", meta.status]}>{meta.status}</span>
              </div>
              <p>{excerptFor(post)}</p>
              <div class="tags">
                {techTags(post).map((tag) => <span>{tag}</span>)}
              </div>
              <div class="actions">
                <a href={postUrl(post)}>read</a>
                {meta.links?.map((link) => <a href={link.href}>{link.label}</a>)}
                {(typeof stars === "number" || typeof commits === "number" || age) && (
                  <span class="repo-stat" title={`Repo stats refreshed from ${repoStats?.source ?? "local data"}`}>
                    {typeof stars === "number" && <span>★ {stars}</span>}
                    {typeof stars === "number" && (typeof commits === "number" || age) && <span>·</span>}
                    {typeof commits === "number" && <span>{commits} commits</span>}
                    {typeof commits === "number" && age && <span>·</span>}
                    {age && <span>◷ {age}</span>}
                  </span>
                )}
              </div>
            </article>
          );
        })}
      </div>
    </section>
  </main>
</BaseLayout>
