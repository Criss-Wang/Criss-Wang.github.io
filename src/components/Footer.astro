---
import { profile } from "../data/profile";

interface Props {
  section?: string;
}

const { section = "home" } = Astro.props;
const footerBrand = "Zhenlin.Wang";
---

<footer>
  {section === "home" ? (
    <div class="footer-inner footer-grid">
      <div>
        <div class="build">
          <div><strong>{footerBrand} · CC BY 4.0 · <a href="/rss.xml">RSS</a></strong></div>
          <div><strong>Personal blogs, projects, and research archive</strong></div>
        </div>
      </div>
      <div>
        <h4>Site</h4>
        <ul>
          <li><a href="/writing/">writing</a></li>
          <li><a href="/publications/">research</a></li>
          <li><a href="/projects/">projects</a></li>
          <li><a href="/about/">about</a></li>
          <li><a href="/rss.xml">rss</a></li>
        </ul>
      </div>
      <div>
        <h4>Contact</h4>
        <ul>
          {profile.links.filter((link) => link.label !== "Email").map((link) => (
            <li><a href={link.href}>{link.label.toLowerCase()}</a></li>
          ))}
          <li><a href={`mailto:${profile.email}`}>email</a></li>
        </ul>
      </div>
    </div>
  ) : (
    <div class="footer-inner">
      <div>{footerBrand} · CC BY 4.0 · <a href="/rss.xml">RSS</a></div>
      <nav aria-label="Footer navigation">
        <a href="/about/">about</a>
        <a href="/writing/">writing</a>
        <a href="/publications/">research</a>
        <a href="/projects/">projects</a>
        <a href="/contact/">contact</a>
      </nav>
    </div>
  )}
</footer>
